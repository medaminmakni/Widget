# Public URL of the site once it is online (used for SEO links, sitemap and social previews)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form e-mail delivery (optional). Without these, the form works but only logs requests in the terminal.
# Create a free account at https://resend.com, verify your domain, then fill these in.
RESEND_API_KEY=
CONTACT_TO=contact@yourdomain.com
CONTACT_FROM=Widget Consulting <site@yourdomain.com>
